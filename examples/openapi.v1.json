  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid",
            "title": "Action Id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "title": "Label"
          },
          "origin": {
            "$ref": "#/components/schemas/ActionOrigin"
          },
          "changes": {
            "patternProperties": {
              "^[a-z][a-z0-9_-]*:[^\\s]+$": {
                "type": "number"
              }
            },
            "type": "object",
            "title": "Changes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_id",
          "label",
          "origin"
        ],
        "title": "Action",
        "description": "Alternative next action; changes are absolute current setpoints."
      },
      "ActionInput": {
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "title": "Label",
            "default": "Вариант оператора"
          },
          "changes": {
            "patternProperties": {
              "^[a-z][a-z0-9_-]*:[^\\s]+$": {
                "type": "number"
              }
            },
            "type": "object",
            "title": "Changes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ActionInput"
      },
      "ActionOrigin": {
        "type": "string",
        "enum": [
          "baseline",
          "system",
          "operator"
        ],
        "title": "ActionOrigin"
      },
      "Admissibility": {
        "type": "string",
        "enum": [
          "admissible",
          "rejected",
          "not_assessable"
        ],
        "title": "Admissibility"
      },
      "Applicability": {
        "type": "string",
        "enum": [
          "supported",
          "unsupported",
          "insufficient_data"
        ],
        "title": "Applicability"
      },
      "CheckCategory": {
        "type": "string",
        "enum": [
          "data",
          "quality",
          "reliability",
          "control",
          "applicability"
        ],
        "title": "CheckCategory"
      },
      "CheckResult": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "title": "Code"
          },
          "passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passed"
          },
          "category": {
            "$ref": "#/components/schemas/CheckCategory"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "actual": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual"
          },
          "limit": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "passed",
          "category",
          "message"
        ],
        "title": "CheckResult"
      },
      "ControlResponse": {
        "properties": {
          "signal_id": {
            "type": "string",
            "title": "Signal Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          },
          "step": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          },
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "signal_id",
          "label",
          "available",
          "reason",
          "unit",
          "min",
          "max",
          "step",
          "source"
        ],
        "title": "ControlResponse"
      },
      "ControlsResponse": {
        "properties": {
          "constraint_version": {
            "type": "string",
            "title": "Constraint Version"
          },
          "controls": {
            "items": {
              "$ref": "#/components/schemas/ControlResponse"
            },
            "type": "array",
            "title": "Controls"
          },
          "review_issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Review Issues"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "constraint_version",
          "controls",
          "review_issues"
        ],
        "title": "ControlsResponse"
      },
      "Decision": {
        "properties": {
          "decision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Decision Id"
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid",
            "title": "Snapshot Id"
          },
          "horizon_minutes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Horizon Minutes"
          },
          "status": {
            "$ref": "#/components/schemas/DecisionStatus"
          },
          "baseline": {
            "$ref": "#/components/schemas/ScenarioEvaluation"
          },
          "preferred": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScenarioEvaluation"
              },
              {
                "type": "null"
              }
            ]
          },
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/ScenarioEvaluation"
            },
            "type": "array",
            "maxItems": 2,
            "title": "Alternatives"
          },
          "rejected_evaluations": {
            "items": {
              "$ref": "#/components/schemas/ScenarioEvaluation"
            },
            "type": "array",
            "title": "Rejected Evaluations"
          },
          "explanation": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Explanation"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceEntry"
            },
            "type": "array",
            "title": "Trace"
          },
          "dataset_version": {
            "type": "string",
            "minLength": 1,
            "title": "Dataset Version"
          },
          "model_version": {
            "type": "string",
            "minLength": 1,
            "title": "Model Version"
          },
          "constraint_version": {
            "type": "string",
            "minLength": 1,
            "title": "Constraint Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision_id",
          "snapshot_id",
          "horizon_minutes",
          "status",
          "baseline",
          "preferred",
          "alternatives",
          "rejected_evaluations",
          "explanation",
          "trace",
          "dataset_version",
          "model_version",
          "constraint_version"
        ],
        "title": "Decision"
      },
      "DecisionListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DecisionSummary"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "DecisionListResponse"
      },
      "DecisionRequest": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid",
            "title": "Snapshot Id"
          },
          "horizon_minutes": {
            "type": "integer",
            "const": 60,
            "title": "Horizon Minutes",
            "default": 60
          },
          "operator_action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActionInput"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id"
        ],
        "title": "DecisionRequest"
      },
      "DecisionResponse": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "current_snapshot_id": {
            "type": "string",
            "format": "uuid",
            "title": "Current Snapshot Id"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "current_snapshot_id",
          "stale"
        ],
        "title": "DecisionResponse"
      },
      "DecisionStatus": {
        "type": "string",
        "enum": [
          "change_recommended",
          "no_change",
          "insufficient_data",
          "no_feasible_option"
        ],
        "title": "DecisionStatus"
      },
      "DecisionSummary": {
        "properties": {
          "decision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Decision Id"
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid",
            "title": "Snapshot Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "status": {
            "$ref": "#/components/schemas/DecisionStatus"
          },
          "saved": {
            "type": "boolean",
            "title": "Saved"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision_id",
          "snapshot_id",
          "created_at",
          "status",
          "saved"
        ],
        "title": "DecisionSummary"
      },
      "EpisodeResponse": {
        "properties": {
          "episode_id": {
            "type": "string",
            "title": "Episode Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "step_minutes": {
            "type": "integer",
            "title": "Step Minutes"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "episode_id",
          "name",
          "start",
          "end",
          "step_minutes",
          "synthetic",
          "limitations"
        ],
        "title": "EpisodeResponse"
      },
      "EpisodesResponse": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/EpisodeResponse"
            },
            "type": "array",
            "title": "Episodes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "episodes"
        ],
        "title": "EpisodesResponse"
      },
      "EstimateBasis": {
        "type": "string",
        "enum": [
          "measured",
          "predicted",
          "proxy",
          "unavailable"
        ],
        "title": "EstimateBasis"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "model_ready": {
            "type": "boolean",
            "title": "Model Ready"
          },
          "data_ready": {
            "type": "boolean",
            "title": "Data Ready"
          },
          "database_ready": {
            "type": "boolean",
            "title": "Database Ready"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ready",
          "model_ready",
          "data_ready",
          "database_ready"
        ],
        "title": "HealthResponse"
      },
      "HistoryRecord": {
        "properties": {
          "signal_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$",
            "title": "Signal Id"
          },
